{
  "name": "vocabflow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:dictionary": "node scripts/build-dictionary.mjs",
    "build:custom-dictionary": "node --experimental-strip-types custom-dictionary/scripts/build-dictionary.mjs",
    "prebuild": "npm run build:dictionary",
    "test": "vitest run",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@types/chrome": "^0.3.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "bn-en-dictionary": "^1.0.2",
    "cmu-pronouncing-dictionary": "^3.0.0",
    "fake-indexeddb": "6.2.6",
    "jsdom": "30.1.3",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wordnet-db": "^3.1.14"
  }
}
