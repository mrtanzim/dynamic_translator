# Copy to `.env.local` and fill in your own key. `.env.local` is git-ignored.
# Get a key at https://console.groq.com/keys
#
# NOTE: The key is seeded into chrome.storage.local ONLY when running `vite dev` (local
# development). Running `npm run build` (production) never embeds the key in the output bundle.
VITE_GROQ_API_KEY=
# Optional: override the seeded Groq model.
VITE_GROQ_MODEL=qwen/qwen3.8-27b
