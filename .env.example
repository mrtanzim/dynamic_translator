# Copy to `.env.local` and fill in your own key. `.env.local` is git-ignored.
# Get a key at https://console.groq.com/keys
#
# WARNING: Vite inlines this value at build time, so the key ends up verbatim in
# the built service-worker bundle (`dist/assets/service-worker.*.js`). Anyone
# with the built extension can extract it. Only use this for controlled
# testing / internal distribution, and rotate the key before production use.
VITE_GROQ_API_KEY=
# Optional: override the seeded Groq model.
VITE_GROQ_MODEL=qwen/qwen3.8-27b
